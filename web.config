<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Block project source files" stopProcessing="true">
                    <match url="^(?:\.env|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$))" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="Serve event static files" stopProcessing="true">
                    <match url="^([0-9]+)/(.+\.(?:css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|map|pdf))$" ignoreCase="true" />
                    <action type="Rewrite" url="public/{R:2}" />
                </rule>
                <rule name="Serve shared public files" stopProcessing="true">
                    <match url="^((?:adminlte|css|dist|downloads|fonts|fonts1|imgs|js|upload)/.*)$" ignoreCase="true" />
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>
                <rule name="Laravel event routes" stopProcessing="true">
                    <match url="^[0-9]+(?:/.*)?$" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>
            </rules>
        </rewrite>
        <directoryBrowse enabled="false" />
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
